diff --git a/agent-core/web/css/style.css b/agent-core/web/css/style.css
index 832bbb7..6695b52 100644
--- a/agent-core/web/css/style.css
+++ b/agent-core/web/css/style.css
@@ -9802,3 +9802,25 @@ html, body {
 @media (max-width: 760px) {
   .bm-tl-r { grid-template-columns: 1fr 52px 1fr; gap: 6px; }
 }
+
+/* PrimeBot Q1 battery readout in canvas detail and monitor panels. */
+.q1-battery { width:100%; min-height:0; overflow:auto; padding:16px; color:var(--text); font-variant-numeric:tabular-nums; }
+.q1-battery header { display:flex; align-items:center; justify-content:space-between; gap:8px; font-size:12px; color:var(--text-muted); }
+.q1-battery .q1-signal { color:var(--text-muted); }
+.q1-battery[data-state="live"] .q1-signal { color:var(--green); }
+.q1-battery[data-state="stale"] .q1-signal { color:var(--yellow); }
+.q1-signal::before { content:""; display:inline-block; width:6px; height:6px; margin-right:5px; background:currentColor; border-radius:50%; vertical-align:middle; }
+.q1-charge { display:flex; align-items:baseline; gap:4px; padding-top:3px; }
+.q1-charge strong { font-size:38px; font-weight:650; line-height:1.15; letter-spacing:-.04em; }
+.q1-charge span { font-size:16px; color:var(--text-muted); }
+.q1-battery progress { display:block; appearance:none; width:100%; height:5px; margin:9px 0 14px; border:0; border-radius:4px; overflow:hidden; color:var(--green); background:var(--bg-input); }
+.q1-battery progress::-webkit-progress-bar { background:var(--bg-input); }
+.q1-battery progress::-webkit-progress-value { background:currentColor; }
+.q1-battery progress::-moz-progress-bar { background:currentColor; }
+.q1-battery[data-state="stale"] progress { color:var(--text-dim); }
+.q1-metrics { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,96px),1fr)); gap:10px 14px; }
+.q1-metrics dt, .q1-metrics small { color:var(--text-muted); font-size:11px; }
+.q1-metrics dd { margin-top:2px; white-space:nowrap; }
+.q1-metrics dd b { font-size:17px; font-weight:600; }
+.q1-battery details { margin-top:14px; border-top:1px solid var(--border); }
+.q1-battery summary { cursor:pointer; font-size:12px; color:var(--text-muted); padding:9px 0; }
